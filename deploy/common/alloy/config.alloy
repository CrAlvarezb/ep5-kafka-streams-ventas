// Grafana Alloy: lee los logs de todos los contenedores Docker del host y los envia a Loki
// con etiquetas host, container y service (servicio de Docker Compose).
discovery.docker "contenedores" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "contenedores" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "contenedores" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.contenedores.targets
  relabel_rules = discovery.relabel.contenedores.rules
  labels        = {host = sys.env("HOST_NAME")}
  forward_to    = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = sys.env("LOKI_URL")
  }
}
