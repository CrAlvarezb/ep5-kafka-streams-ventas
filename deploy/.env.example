# Variables que el bootstrap de Terraform escribe en /opt/ep5/<rol>/.env de cada EC2.
# Referencia: no hace falta copiarlo a mano. Las IP son las privadas fijas de infra/variables.tf.
HOST_NAME=kafka-1
HOST_IP=10.20.1.10
BROKER_ID=1
ZK_CONNECT=10.20.1.10:2181
KAFKA_BOOTSTRAP_SERVERS=10.20.1.10:9092,10.20.2.10:9092
KAFKA_1_IP=10.20.1.10
KAFKA_2_IP=10.20.2.10
APP_IP=10.20.2.20
LOKI_URL=http://10.20.2.30:3100/loki/api/v1/push
# Solo en monitoring (las genera Terraform: terraform -chdir=infra output -raw grafana_password)
GRAFANA_ADMIN_PASSWORD=cambiar
KAFKA_UI_PASSWORD=cambiar
