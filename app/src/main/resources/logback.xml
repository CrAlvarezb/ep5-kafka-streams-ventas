<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC} %-5level %logger{0} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Kafka es muy verboso en INFO; se dejan solo advertencias salvo los cambios de estado -->
  <logger name="org.apache.kafka" level="WARN"/>
  <logger name="CasosApp" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
