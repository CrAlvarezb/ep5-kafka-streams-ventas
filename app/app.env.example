# Configuracion de la app (producer y Kafka Streams). Copiar a app.env y ajustar.
# No contiene secretos: Kafka del laboratorio no usa autenticacion.
KAFKA_BOOTSTRAP_SERVERS=10.20.1.10:9092,10.20.2.10:9092
APPLICATION_ID=ventas-aggregator
TOPIC_RAW=ventas-raw
TOPIC_AGREGADAS=ventas-agregadas
TOPIC_DLQ=ventas-raw-dlq
TOPIC_DESCARTADAS=ventas-descartadas
# Ventana tumbling por eventTime y gracia para eventos fuera de orden
VENTANA_SEGUNDOS=60
GRACIA_SEGUNDOS=30
# Retencion del store de deduplicacion (>= ventana + gracia)
DEDUP_RETENCION_SEGUNDOS=600
# eventTime mas alla de ahora + esto se rechaza (REGLA_NEGOCIO)
FUTURO_MAX_SEGUNDOS=300
REPLICATION_FACTOR=2
NUM_STREAM_THREADS=1
STATE_DIR=/tmp/kafka-streams
# Ritmo del productor continuo
VENTAS_POR_SEGUNDO=2
